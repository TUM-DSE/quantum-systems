---
import Layout from '../layouts/Layout.astro';
import PersonCard from '../components/PersonCard.astro';
import Arrow from '../components/Arrow.astro';
import { currentTeam } from '../lib/content';
const current = currentTeam;
---
<Layout title="Team" active="Team"><div class="wrap"><header class="page-heading"><h1>Team</h1></header><div class="people-grid">{current.map((person) => <PersonCard person={person}/>)}</div><div class="source-note"><a href="https://dse.in.tum.de/team/">Lab directory <Arrow diagonal/></a></div></div></Layout>
