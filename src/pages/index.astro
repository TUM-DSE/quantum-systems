---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PersonCard from '../components/PersonCard.astro';
import Arrow from '../components/Arrow.astro';
import { projects, currentTeam, people, path } from '../lib/content';
const alumni = people.filter((person) => person.group === 'alumni');
---
<Layout>
  <section class="hero wrap"><h1>Quantum<br/>Systems<br/>@ TUM</h1><img class="hero-art" src={path('illustrations/hero.svg')} alt="Classical and quantum processors linked by a shared system" width="600" height="440"/></section>
  <section class="research-intro wrap section-rule" aria-labelledby="research"><h2 id="research">Research</h2><div><p>We build the systems behind quantum computing.</p><p>Our work spans compilers, operating systems, quantum error correction, and the interface between quantum and classical hardware.</p></div></section>
  <section class="section wrap" aria-labelledby="projects"><div class="section-heading"><h2 id="projects">Projects</h2><a class="text-link" href={path('projects/')}>Project index <Arrow /></a></div><div class="area-grid">{projects.map((project) => <ProjectCard project={project}/>)}</div></section>
  <section class="section wrap" aria-labelledby="team"><div class="section-heading"><h2 id="team">Team</h2></div><div class="people-grid home-people">{currentTeam.map((person) => <PersonCard person={person}/>)}</div></section>
  {alumni.length > 0 && <section class="section wrap" aria-labelledby="alumni"><div class="section-heading"><h2 id="alumni">Alumni</h2></div><div class="people-grid">{alumni.map((person) => <PersonCard person={person}/>)}</div></section>}
</Layout>
